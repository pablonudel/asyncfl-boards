generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator kysely {
  provider = "prisma-kysely"
  output   = "../types"
  fileName = "db.d.ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name             String
  firstName        String
  lastName         String
  email            String          @unique
  emailVerified    Boolean         @default(false)
  image            String?
  projects         Project[]
  pfcCredentialsId pfcCredentials?

  sessions     Session[]
  accounts     Account[]
  jobs         Job[]
  runs         Run[]
  environments Environment[]
  datasets     Dataset[]
  files        File[]
}

model Environment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hashedReqs          String
  requirementsContent String
  status              String @default("PENDING") // PENDING, BUILDING, READY, FAILED

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs   Run[]
  jobs   Job[]
}

model Job {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folderId      String       @unique
  name          String
  description   String?
  status        String       @default("CREATED") // CREATED, READY, SYNCING
  sourceFiles   String[]
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs   Run[]
}

model Dataset {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fileName      String  @unique
  readmeContent String?
  folderId      String  @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Run {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  runName       String
  runFolderId   String   @unique
  entryFile     String?
  pythonVersion String?
  paramsConfig  Json?
  sbatchConfig  Json?
  status        String   @default("NOT STARTED") // NOT STARTED, PREPARING, QUEUED, RUNNING, COMPLETED, FAILED
  slurmJobId    Int?
  datasetsFiles String[] @default([])
  runSnapshot   Json?

  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id])
  jobId         String
  job           Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String
  description  String?
  widgets      Widget[]
  widgetsOrder String[] @default([])
  isPublic     Boolean  @default(false)
  idPublic     String?  @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model File {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fileName      String
  referenceName String @unique
  fileSize      Float
  fileShape     Int[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Widget {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type      String?
  config    Json
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model pfcCredentials {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  username String?
  password String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Auth sessions and accounts

model Session {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  identifier String
  value      String
  expiresAt  DateTime
}
