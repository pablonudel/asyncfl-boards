# ============================================
# AsyncFL Board - Base Environment Configuration
# ============================================
# 
# This file is committed to git as a template.
# For local development: copy to .env.local
# For production: copy to .env.production (not in git!)
#
# NEVER commit actual secrets to git.
# Use .env.local for local development overrides.
# Use .env.production.local for production secrets (not in git).

# --- Database Configuration ---
DB_USER=asyncfl
DB_PASSWORD=change_me_in_env_local
DB_NAME=asyncfl_db
DATABASE_URL=postgresql://asyncfl:change_me_in_env_local@db:5432/asyncfl_db?schema=public

# --- Better Auth & Security ---
BETTER_AUTH_SECRET=change_me_in_env_local__generate_random_string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_PROD_HOSTNAME=localhost

# --- Storage ---
STORAGE_PATH_BASE=./storage

# --- Admin Credentials (Change in .env.local!) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_in_env_local

# --- SMTP Configuration (Optional) ---
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=change_me_in_env_local
